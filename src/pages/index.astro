---
import Layout from '../layouts/Layout.astro';
import GroupList from '../components/GroupList.astro';
import SourceState from '../components/SourceState.astro';
import ServiceList from '../components/ServiceList.astro';
import NewsList from '../components/NewsList.astro';
import { loadGroups, loadNews, loadServices } from '../lib/content';
import { externalLinks, siteName } from '../lib/site';
import stockCredits from '../../public/entwuerfe/neu/stock/credits.json';

export const prerender = false;
const [services, news, groups] = await Promise.all([loadServices(), loadNews(), loadGroups()]);
Astro.response.headers.set('Cache-Control', 'no-store');
const cafe = externalLinks.find((link) => link.label === 'Café Dreimaster');
---
<Layout title="Schön, dass du da bist" description="Willkommen in der Apostel-Kirchengemeinde Kiel. Lerne unsere Gemeinde kennen und entdecke Gottesdienste und Begegnungen. Website-Entwurf.">
  <div class="encounters">
    <section class="encounters-hero" aria-labelledby="willkommen">
      <div class="container encounters-opening">
        <div class="encounters-copy">
          <p class="encounters-identity">{siteName}</p>
          <h1 id="willkommen">Schön, dass du<br />da bist.</h1>
          <p class="encounters-intro">Ob du zum ersten Mal vorbeischaust oder schon lange zur Gemeinde gehörst: Wir freuen uns auf dich.</p>
          <div class="encounters-actions">
            <a class="button" href="/gemeinde">Gemeinde kennenlernen <span aria-hidden="true">→</span></a>
            <a class="text-link" href="#dein-weg">Deinen Weg finden <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <div class="encounters-mosaic" role="group" aria-label="Drei unabhängige Symbolfotos von Begegnungen">
          {stockCredits.photos.map((photo, index) => (
            <figure class:list={['encounters-photo', { 'encounters-photo-lead': index === 0 }]}>
              <img
                src={`/entwuerfe/neu/stock/${photo.id}-640.webp`}
                srcset={`/entwuerfe/neu/stock/${photo.id}-640.webp 640w, /entwuerfe/neu/stock/${photo.id}-1280.webp 1280w`}
                sizes={index === 0 ? '(min-width: 1440px) 624px, (min-width: 621px) 46vw, 90vw' : '(min-width: 1440px) 305px, (min-width: 621px) 23vw, 45vw'}
                width="1280" height="853" alt={photo.alt}
                loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} decoding="async"
              />
              <figcaption class="photo-credit">Symbolfoto</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="encounters-community" aria-labelledby="miteinander">
      <div class="container encounters-panel">
        <div class="encounters-heading">
          <h2 id="miteinander">Miteinander leben.</h2>
          <p>Wir möchten Menschen zusammenbringen – im Gottesdienst, im Gespräch und im Alltag.</p>
        </div>
        <div class="encounters-paths" id="dein-weg" tabindex="-1">
          <section class="encounters-path" aria-labelledby="gottesdienst">
            <h3 id="gottesdienst">Zeit füreinander.</h3>
            <p>Zur Ruhe kommen, gemeinsam glauben, neue Gedanken mitnehmen. Gottesdienst ist eine Einladung – auch mit offenen Fragen.</p>
            <a class="text-link" href="/gottesdienste">Zu den Gottesdiensten <span aria-hidden="true">→</span></a>
            <SourceState status={services.status} kind="services" updatedAt={services.updatedAt} compact />
            {services.items.length > 0 && <ServiceList items={services.items.slice(0, 1)} headingLevel="h3" />}
          </section>
          <section class="encounters-path" aria-labelledby="gemeindeleben">
            <h3 id="gemeindeleben">Gemeinde erleben.</h3>
            <p>Entdecke die Angebote und Gruppen der Apostel-Kirchengemeinde.</p>
            <a class="text-link" href="/angebote">Angebote &amp; Gruppen <span aria-hidden="true">→</span></a>
            <SourceState status={groups.status} kind="groups" updatedAt={groups.updatedAt} compact />
            {groups.items.length > 0 && <GroupList items={groups.items.slice(0, 3)} preview />}
          </section>
          <section class="encounters-path" aria-labelledby="gespraech">
            <h3 id="gespraech">Ins Gespräch kommen.</h3>
            <p>Du hast eine Frage zur Gemeinde? Hier findest du den Weg zu unserem Kontakt.</p>
            <a class="text-link" href="/kontakt">Kontakt aufnehmen <span aria-hidden="true">→</span></a>
          </section>
        </div>
      </div>
    </section>

    <section class="container encounters-news" aria-labelledby="neuigkeiten">
      <div class="encounters-news-heading">
        <div><h2 id="neuigkeiten">Was die Gemeinde bewegt.</h2><p>Neuigkeiten und aktuelle Informationen aus der Apostel-Kirchengemeinde.</p></div>
        <a class="text-link" href="/aktuelles">Aktuelles aus der AKG <span aria-hidden="true">→</span></a>
      </div>
      <SourceState status={news.status} kind="news" updatedAt={news.updatedAt} compact />
      {news.items.length > 0 && <NewsList items={news.items.slice(0, 3)} headingLevel="h3" />}
    </section>

    <section class="container encounters-cafe" aria-labelledby="dreimaster">
      <h2 id="dreimaster">Café Dreimaster</h2>
      <div><p>Lerne das Café kennen und finde die aktuellen Informationen für deinen Besuch auf der Dreimaster-Website.</p>
        {cafe && <a class="text-link" href={cafe.href}>Zum Café Dreimaster <span class="external-label">eigene Website ↗</span></a>}
      </div>
    </section>
    <p class="container encounters-photo-note">Die Symbolfotos zeigen keine AKG-Veranstaltung. Eine Zugehörigkeit oder Unterstützung durch die abgebildeten Personen wird nicht behauptet. <a href={stockCredits.licenseURL}>Fotolizenz: {stockCredits.license}</a>.</p>
  </div>
</Layout>

<style>
  /* Keep the chosen homepage composition isolated from the existing subpages. */
  :global(body:has(.encounters) .container) { width: min(calc(100% - 2 * clamp(1.25rem, 5.55vw, 5rem)), 80rem); }
  :global(body:has(.encounters) .masthead) { min-height: 6.375rem; }
  :global(body:has(.encounters) .wordmark img) { width: 8rem; }
  :global(body:has(.encounters) .site-footer) { background: var(--color-ink); }
  .encounters { line-height: 1.5; }
  .encounters-hero { background: var(--color-blue); color: var(--color-paper); --focus: var(--color-paper); }
  .encounters-opening { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 4rem; align-items: center; padding-block: 2.75rem; }
  .encounters-copy { padding-block: 1.875rem; }
  .encounters-identity { font-size: 1rem; margin-bottom: 1.5rem; }
  .encounters-copy h1 { font-size: clamp(3rem, 4.7vw, 4.25rem); line-height: 1.04; letter-spacing: -.04em; text-wrap: initial; margin-bottom: 1.75rem; }
  .encounters-intro { font-size: 1.25rem; max-width: 38ch; }
  .encounters-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .625rem 1.5rem; margin-top: 1.875rem; }
  .encounters-actions .button { background: var(--color-paper); color: var(--color-blue); border-radius: .3125rem; min-height: 3.25rem; }
  .encounters-actions .button:hover { background: var(--color-wash); color: var(--color-ink); }
  .encounters-actions .text-link { font-size: 1rem; }
  .text-link { text-decoration: none; }
  .text-link:hover { text-decoration: underline; }
  .encounters-mosaic { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .875rem; }
  .encounters-photo { position: relative; min-width: 0; border-radius: .75rem; background: var(--color-paper); color: var(--color-ink); --focus: var(--color-ink); }
  .encounters-photo img { width: 100%; height: 11.25rem; object-fit: cover; border-radius: inherit; }
  .encounters-photo-lead { grid-column: 1 / -1; }
  .encounters-photo-lead img { height: 13.75rem; object-position: center 30%; }
  .encounters-photo .photo-credit { position: absolute; top: .5rem; left: .5rem; max-width: calc(100% - 1rem); padding: .125rem .375rem; border-radius: .25rem; font-size: .75rem; line-height: 1.5; overflow-wrap: anywhere; color: var(--color-ink); background: var(--color-paper); pointer-events: none; }
  .encounters-community { background: var(--color-green-wash); padding-block: 2.75rem; }
  .encounters-panel { background: var(--color-paper); border-radius: 1.5rem; padding: 3rem 3rem 2.25rem; }
  .encounters-heading { text-align: center; max-width: 46.25rem; margin-inline: auto; }
  .encounters-heading h2 { color: var(--color-green); font-size: 2.75rem; margin-bottom: 1.375rem; }
  .encounters-heading p { font-size: 1.25rem; }
  .encounters-paths { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; margin-top: 2.5rem; }
  .encounters-paths:focus { outline: 3px solid var(--color-focus); outline-offset: .5rem; }
  .encounters-path { border-top: 1px solid var(--color-line); padding-top: 1.5rem; min-width: 0; }
  .encounters-path h3 { font-size: 1.5625rem; margin-bottom: 1rem; }
  .encounters-path > .text-link { margin-top: .875rem; color: var(--color-blue); font-size: 1rem; }
  .encounters-path :global(.source-state) { padding-block: .75rem 0; font-size: .875rem; }
  .encounters-path :global(.state-title) { font-weight: 450; }
  .encounters-path :global(.service-item) { padding-block: 1rem 0; }
  .encounters-path :global(.service-item h3) { font-size: 1.25rem; }
  .encounters-path :global(.offer-preview) { margin-block: .5rem 0; }
  .encounters-path :global(.offer-teaser) { grid-template-columns: minmax(0, 1fr); gap: .25rem; padding-block: .625rem; }
  .encounters-path :global(.offer-teaser h3) { font-size: 1.125rem; }
  .encounters-path :global(.offer-teaser p) { font-size: 1rem; }
  .encounters-news { padding-block: 3rem; }
  .encounters-news-heading { display: flex; justify-content: space-between; align-items: center; gap: 2rem; }
  .encounters-news h2 { font-size: 2rem; margin-bottom: 1rem; }
  .encounters-news-heading p { max-width: 52ch; font-size: 1.125rem; }
  .encounters-news-heading > .text-link { color: var(--color-blue); flex-shrink: 0; }
  .encounters-news :global(.source-state) { padding-bottom: 0; }
  .encounters-news :global(.state-title) { font-size: .9375rem; font-weight: 450; }
  .encounters-news :global(.news-list) { margin-top: 1rem; }
  .encounters-cafe { display: grid; grid-template-columns: 1fr 2fr; gap: 3rem; align-items: center; padding-block: 2rem 3rem; border-top: 1px solid var(--color-line); }
  .encounters-cafe h2 { font-size: 1.8125rem; }
  .encounters-cafe p { max-width: 58ch; }
  .encounters-cafe .text-link { margin-top: .625rem; color: var(--color-blue); flex-wrap: wrap; }
  .encounters-photo-note { font-size: .8125rem; color: var(--color-muted); padding-bottom: 2rem; }
  @media (max-width: 65.625rem) {
    .encounters-opening { gap: 2rem; }
    .encounters-copy h1 { font-size: 3.375rem; }
    .encounters-intro { font-size: 1.125rem; }
    .encounters-photo img { height: 10rem; }
    .encounters-photo-lead img { height: 12.5rem; }
    .encounters-panel { padding: 2.25rem 2rem; }
    .encounters-paths { gap: 1.5rem; }
    .encounters-path h3 { font-size: 1.4375rem; }
  }
  @media (max-width: 56.25rem) {
    .encounters-opening { gap: 1.75rem; padding-block: 2rem; }
    .encounters-copy { padding-block: .75rem; }
    .encounters-copy h1 { font-size: 2.75rem; }
    .encounters-identity { font-size: .875rem; margin-bottom: 1.25rem; }
    .encounters-intro { font-size: 1.0625rem; }
    .encounters-actions { margin-top: 1.375rem; }
    .encounters-actions .button { padding-inline: 1rem; font-size: .9375rem; gap: .75rem; }
    .encounters-mosaic { gap: .625rem; }
    .encounters-photo img { height: 8.75rem; }
    .encounters-photo-lead img { height: 11.25rem; }
    .encounters-heading h2 { font-size: 2.3125rem; }
    .encounters-heading p { font-size: 1.125rem; }
    .encounters-paths { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; margin-top: 1.875rem; }
    .encounters-path { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: .5rem 1.5rem; }
    .encounters-path > * { grid-column: 2; }
    .encounters-path h3 { grid-column: 1; grid-row: 1 / 4; font-size: 1.625rem; }
    .encounters-path > .text-link { margin-top: .25rem; }
    .encounters-cafe { gap: 1.5rem; }
  }
  @media (max-width: 38.75rem) {
    :global(body:has(.encounters) .masthead) { min-height: 5.25rem; }
    :global(body:has(.encounters) .wordmark img) { width: 7rem; }
    :global(body:has(.encounters) .mobile-menu summary) { top: 1.25rem; }
    .encounters-opening { display: block; padding-block: 2rem; }
    .encounters-copy { padding: 0; }
    .encounters-identity { margin-bottom: 1.125rem; }
    .encounters-copy h1 { font-size: clamp(2.375rem, 10.5vw, 3rem); margin-bottom: 1.5rem; }
    .encounters-intro { font-size: 1.125rem; }
    .encounters-actions { display: block; margin-top: 1.5rem; }
    .encounters-actions .button { width: 100%; justify-content: space-between; font-size: 1rem; }
    .encounters-actions .text-link { margin-top: .375rem; }
    .encounters-mosaic { margin-top: 1.625rem; }
    .encounters-photo img { height: 8.4375rem; }
    .encounters-photo-lead img { height: 11.875rem; object-position: center; }
    .encounters-community { padding-block: 1.5rem; }
    .encounters-panel { padding: 1.75rem 1.375rem .375rem; border-radius: 1rem; }
    .encounters-heading { text-align: left; }
    .encounters-heading h2 { font-size: 1.9375rem; margin-bottom: 1.25rem; }
    .encounters-heading p { font-size: 1.0625rem; }
    .encounters-paths { margin-top: 1.75rem; gap: 0; }
    .encounters-path { display: block; padding-block: 1.5rem; }
    .encounters-path h3 { font-size: 1.5625rem; margin-bottom: .875rem; }
    .encounters-path > .text-link { margin-top: .625rem; }
    .encounters-news { padding-block: 2.25rem; }
    .encounters-news-heading { display: block; }
    .encounters-news h2 { font-size: 1.75rem; }
    .encounters-news-heading p { font-size: 1.0625rem; }
    .encounters-news-heading > .text-link { margin-top: .875rem; }
    .encounters-cafe { display: block; padding-block: 1.75rem 2.25rem; }
    .encounters-cafe h2 { margin-bottom: 1.125rem; }
  }
</style>
