---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import KielPostmark from '../components/KielPostmark.astro';
import GroupList from '../components/GroupList.astro';
import SourceState from '../components/SourceState.astro';
import ServiceList from '../components/ServiceList.astro';
import NewsList from '../components/NewsList.astro';
import { loadGroups, loadNews, loadServices } from '../lib/content';
import { cafeSite, concertSite } from '../lib/site';
import '../styles/edition.css';

export const prerender = false;
const [services, news, groups] = await Promise.all([loadServices(), loadNews(), loadGroups()]);
Astro.response.headers.set('Cache-Control', 'no-store');
---
<Layout title="Willkommen" description="Lerne die Apostel-Kirchengemeinde Kiel kennen. Hier geht es zu Gottesdiensten, Gruppen und Nachrichten aus dem Gemeindeleben.">
  <section class="edition-hero" aria-labelledby="willkommen">
    <div class="container edition-spread">
      <div class="edition-welcome">
        <h1 id="willkommen">Glaube trifft <em>Alltag.</em></h1>
        <p>Wir sind die Apostel-Kirchengemeinde Kiel. Hier feiern wir Gottesdienst, teilen unseren Glauben und kommen ins Gespräch.</p>
        <div class="edition-actions">
          <a class="button" href="/gottesdienste">Zu den Gottesdiensten <span aria-hidden="true">→</span></a>
          <a class="text-link" href="/gemeinde">Gemeinde kennenlernen</a>
        </div>
      </div>
      <div class="edition-print"><Photo view="conversation" hero /><KielPostmark /></div>
    </div>
  </section>

  <section class="container edition-directory" aria-labelledby="gemeindeleben">
    <div class="edition-lead">
      <h2 id="gemeindeleben">Mitmachen und <em>mitfeiern.</em></h2>
      <p>Vielleicht suchst du eine Gruppe. Vielleicht möchtest du erst einmal im Gottesdienst zuhören. Beides hat hier Platz.</p>
    </div>
    <div class="edition-index">
      <section aria-labelledby="feiern">
        <h3 id="feiern"><a href="/gottesdienste">Gottesdienste <span aria-hidden="true">→</span></a></h3>
        <SourceState status={services.status} kind="services" updatedAt={services.updatedAt} compact />
        {services.items.length > 0 && <ServiceList items={services.items.slice(0, 1)} headingLevel="h4" />}
      </section>
      <section aria-labelledby="gruppen">
        <h3 id="gruppen"><a href="/angebote">Angebote &amp; Gruppen <span aria-hidden="true">→</span></a></h3>
        <SourceState status={groups.status} kind="groups" updatedAt={groups.updatedAt} compact />
        {groups.items.length > 0 && <GroupList items={groups.items.slice(0, 3)} preview />}
      </section>
      <section aria-labelledby="kontakt">
        <h3 id="kontakt"><a href="/kontakt">Kontakt <span aria-hidden="true">→</span></a></h3>
        <p>Angaben zum Gemeindebüro sind noch in Prüfung.</p>
      </section>
    </div>
  </section>

  <section class="edition-news" aria-labelledby="neuigkeiten">
    <div class="container edition-news-spread">
      <div class="edition-lead"><h2 id="neuigkeiten">Nachrichten aus der Gemeinde.</h2><a class="text-link" href="/aktuelles">Alle Nachrichten <span aria-hidden="true">→</span></a></div>
      <div class="edition-feed">
        <SourceState status={news.status} kind="news" updatedAt={news.updatedAt} />
        {news.items.length > 0 && <NewsList items={news.items.slice(0, 3)} headingLevel="h3" />}
      </div>
    </div>
  </section>

  <section class="container edition-neighbours" aria-labelledby="nebenan">
    <Photo view="cafe" />
    <div>
      <h2 id="nebenan">Im Café <em>Dreimaster.</em></h2>
      <p>Ein Blick ins Café: Was dich dort erwartet, erfährst du auf der eigenen Website.</p>
      <a class="text-link" href={cafeSite.href}>Zum Café Dreimaster <span aria-hidden="true">↗</span></a>
      <p class="edition-crosslink">Du suchst das Konzertprogramm? <a href={concertSite.href}>Zu petruskirche.events <span aria-hidden="true">↗</span></a></p>
    </div>
  </section>
</Layout>
