---
import Site from '../layouts/Site.astro';
import Picture from '../ui/Picture.astro';
import Arrow from '../ui/Arrow.astro';
import FeedNote from '../ui/FeedNote.astro';
import { loadGroups, loadNews, loadServices } from '../lib/content';
import { detailPath, formatDate, formatNewsExcerpt, formatServiceTime } from '../lib/site';
import '../styles/welcome.css';

export const prerender = false;
const [services, news, groups] = await Promise.all([loadServices(), loadNews(), loadGroups()]);
Astro.response.headers.set('Cache-Control', 'no-store');
const next = services.items[0];
---
<Site title="Willkommen" description="Willkommen in der Apostel-Kirchengemeinde Kiel. Plane deinen ersten Besuch, entdecke Gottesdienste und lerne Menschen aus der Gemeinde kennen.">
  <section class="welcome" aria-labelledby="moin">
    <div class="wrap welcome-band">
      <h1 id="moin">Moin, wir sind <strong>Apostel.</strong></h1>
      <div class="welcome-invite">
        <p>Bei uns in Kiel kommen Menschen zusammen, um Gottesdienst zu feiern und ihren Glauben zu teilen. Du bist eingeladen.</p>
        <div class="welcome-actions"><a class="action" href="/besuch">Mein erster Besuch <Arrow /></a><a class="route-link" href="/gemeinde">Unsere Gemeinde</a></div>
      </div>
    </div>
    <Picture view="service" priority sizes="100vw" />
  </section>

  <section class="sunday" aria-labelledby="gottesdienste">
    <div class="wrap sunday-line">
      <h2 id="gottesdienste">{next ? 'Nächster Gottesdienst' : 'Gottesdienste'}</h2>
      <div class="sunday-when">
        <FeedNote result={services} subject="Gottesdiensttermine" />
        {next && <ul role="list"><li><time datetime={next.start}>{formatServiceTime(next)}</time><h3><a href={detailPath('gottesdienste', next.id)}>{next.title}</a></h3></li></ul>}
      </div>
      <a class="route-link" href="/gottesdienste">Zur Gottesdienstübersicht <Arrow /></a>
    </div>
  </section>

  <section class="community" aria-labelledby="miteinander"><div class="wrap together">
    <div class="together-picture"><Picture view="conversation" /></div>
    <div class="together-text">
      <h2 id="miteinander">Menschen <br />kennen<wbr />lernen.</h2>
      <p>Gemeinde ist mehr als der Gottesdienst. In unseren Gruppen teilen Menschen, was sie beschäftigt – im Glauben und im Alltag.</p>
      <div class="together-choices">
        <a href="/angebote">Angebote &amp; Gruppen <Arrow /></a>
        <a href="/kontakt">Zum Gemeindebüro <Arrow /></a>
      </div>
      <FeedNote result={groups} subject="Gruppen" />
      {groups.items.length > 0 && <ul role="list" class="group-samples">{groups.items.slice(0,3).map(g => <li><h3><a href={`/angebote?angebot=${encodeURIComponent(g.id)}#angebot-${g.id}`}>{g.name}</a></h3></li>)}</ul>}
    </div>
  </div></section>

  <section class="updates" aria-labelledby="nachrichten"><div class="wrap">
    <div class="update-intro"><h2 id="nachrichten">Neues aus der Gemeinde</h2><a class="route-link" href="/aktuelles">Alle Meldungen <Arrow /></a></div>
    <FeedNote result={news} subject="Meldungen" />
    {news.items.length > 0 && <ul role="list" class="update-list">{news.items.slice(0,3).map(item => <li>
      <time datetime={item.publishedAt}>{formatDate(item.publishedAt)}</time>
      <div><h3><a href={detailPath('aktuelles', item.id)}>{item.title} <Arrow /></a></h3>{item.body && <p>{formatNewsExcerpt(item.body)}</p>}</div>
    </li>)}</ul>}
  </div></section>
</Site>
