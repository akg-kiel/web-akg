---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import SourceState from '../components/SourceState.astro';
import ServiceList from '../components/ServiceList.astro';
import NewsList from '../components/NewsList.astro';
import { loadNews, loadServices } from '../lib/content';
import { externalLinks } from '../lib/site';

export const prerender = false;
const [services, news] = await Promise.all([loadServices(), loadNews()]);
Astro.response.headers.set('Cache-Control', 'no-store');
const cafe = externalLinks.find((link) => link.label === 'Café Dreimaster');
---
<Layout title="Schön, dass du da bist" description="Willkommen in der Apostel-Kirchengemeinde Kiel. Lerne unsere Gemeinde kennen und entdecke Gottesdienste und Begegnungen. Website-Entwurf.">
  <section class="welcome-hero" aria-labelledby="willkommen">
    <div class="welcome-copy">
      <h1 id="willkommen">Schön, dass<br />du da bist.</h1>
      <p class="hero-intro">Ob du zum ersten Mal vorbeischaust oder schon lange zur Gemeinde gehörst: Wir freuen uns auf dich.</p>
      <div class="hero-actions">
        <a class="button" href="/gemeinde">Gemeinde kennenlernen <span aria-hidden="true">→</span></a>
        <a class="text-link" href="/gottesdienste">Gottesdienste <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <Photo view="service" hero />
  </section>

  <section class="container home-services section" aria-labelledby="gottesdienst">
    <h2 id="gottesdienst">Gottesdienst.<br />Zeit füreinander.</h2>
    <div class="prose">
      <p>Zur Ruhe kommen, gemeinsam glauben, neue Gedanken mitnehmen. Gottesdienst ist eine Einladung – auch mit offenen Fragen.</p>
      <a class="text-link" href="/gottesdienste">Mehr über Gottesdienste <span aria-hidden="true">→</span></a>
      <SourceState status={services.status} kind="services" updatedAt={services.updatedAt} compact />
      {services.items.length > 0 && <ServiceList items={services.items.slice(0, 1)} headingLevel="h3" />}
    </div>
  </section>

  <section class="container community-story section" aria-labelledby="gemeindeleben">
    <div class="section-heading">
      <div>
        <h2 id="gemeindeleben">Miteinander leben</h2>
        <p class="section-description">Wir möchten Menschen zusammenbringen – im Gottesdienst, im Gespräch und im Alltag.</p>
      </div>
      <a class="text-link" href="/angebote">Angebote &amp; Gruppen <span aria-hidden="true">→</span></a>
    </div>
    <div class="community-gallery">
      <Photo view="conversation" enlarge />
      <Photo view="gathering" enlarge />
    </div>
  </section>

  <section class="community-band section" aria-labelledby="miteinander">
    <div class="container community-layout">
      <div class="prose">
        <h2 id="miteinander">Orte der Begegnung</h2>
        <h3>Café Dreimaster</h3>
        <p>Lerne das Café kennen und finde die aktuellen Informationen für deinen Besuch – auf der Dreimaster-Website.</p>
        {cafe && <a class="text-link" href={cafe.href}>Zum Café Dreimaster <span class="external-label">extern ↗</span></a>}
      </div>
      <Photo view="cafe" enlarge />
    </div>
  </section>

  <section class:list={['container section news-section', { 'news-compact': news.items.length === 0 }]} aria-labelledby="neuigkeiten">
    <div class="section-heading">
      <h2 id="neuigkeiten">Neuigkeiten aus der AKG</h2>
      <a class="text-link" href="/aktuelles">Alle Meldungen <span aria-hidden="true">→</span></a>
    </div>
    <SourceState status={news.status} kind="news" updatedAt={news.updatedAt} compact />
    {news.items.length > 0 && <NewsList items={news.items.slice(0, 3)} headingLevel="h3" />}
  </section>

  <dialog class="photo-dialog" aria-label="Foto aus dem Gemeindeleben">
    <div class="photo-dialog-actions">
      <a class="text-link" data-photo-file>Bilddatei öffnen <span aria-hidden="true">→</span></a>
      <form method="dialog"><button class="button" autofocus>Schließen</button></form>
    </div>
    <figure data-photo-content></figure>
  </dialog>
</Layout>
<script>
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  if (!motion.matches && 'IntersectionObserver' in window) {
    const targets = document.querySelectorAll<HTMLElement>(
      '.welcome-copy h1, .hero-intro, .hero-actions, .home-services > *, .community-story .section-heading, .community-gallery figure, .community-layout > *, .news-section .section-heading, .news-section .source-state',
    );
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(({ target, isIntersecting }) => {
        if (!isIntersecting) return;
        target.classList.add('is-entering');
        target.addEventListener('animationend', () => target.classList.remove('is-entering'), { once: true });
        observer.unobserve(target);
      });
    }, { threshold: 0.1 });
    targets.forEach((target) => observer.observe(target));
    motion.addEventListener('change', () => {
      if (!motion.matches) return;
      observer.disconnect();
      targets.forEach((target) => target.classList.remove('is-entering'));
    });
  }

  const dialog = document.querySelector<HTMLDialogElement>('.photo-dialog');
  const content = dialog?.querySelector('[data-photo-content]');
  const fileLink = dialog?.querySelector<HTMLAnchorElement>('[data-photo-file]');
  if (dialog && content && fileLink && typeof dialog.showModal === 'function') {
    document.querySelectorAll<HTMLAnchorElement>('[data-enlarge]').forEach((link) => {
      link.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const original = link.querySelector('img');
        const caption = link.closest('figure')?.querySelector('figcaption');
        if (!original || !caption) return;
        event.preventDefault();
        const image = original.cloneNode() as HTMLImageElement;
        image.removeAttribute('srcset');
        image.removeAttribute('sizes');
        image.loading = 'eager';
        image.src = link.href;
        content.replaceChildren(image, caption.cloneNode(true));
        fileLink.href = link.href;
        dialog.showModal();
      });
    });
  }
</script>
