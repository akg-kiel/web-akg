---
import Interior from '../ui/interior/Interior.astro';
import Go from '../ui/interior/Go.astro';

export const prerender = true;
export function getStaticPaths() {
  return [
    { params: { page: 'impressum' }, props: {
      title: 'Impressum', description: 'Für diese Vorschau liegt noch kein freigegebenes Impressum vor.',
      note: 'Die verbindlichen Angaben zum Anbieter fehlen noch.'
    }},
    { params: { page: 'datenschutz' }, props: {
      title: 'Datenschutz', description: 'Für diese Vorschau liegt noch keine freigegebene Datenschutzerklärung vor.',
      note: 'Die Erklärung zur Datenverarbeitung auf dieser Website muss noch fachlich geprüft werden.'
    }}
  ];
}
interface Props { title: string; description: string; note: string }
const { title, description, note } = Astro.props;
---
<Interior title={title} description={description}>
  <div class="wrap in-detail">
    <h1>{title}</h1>
    <div class="in-prose">
      <p class="in-lead">{description}</p>
      <p>{note} Bis zur Freigabe bleibt die Veröffentlichung der Website gesperrt.</p>
      <Go href="/">Zur Startseite</Go>
    </div>
  </div>
</Interior>
