---
import Interior from '../../ui/interior/Interior.astro';
import ContentState from '../../ui/interior/ContentState.astro';
import CurrentSiteLink from '../../ui/interior/CurrentSiteLink.astro';
import ServiceDates from '../../ui/interior/ServiceDates.astro';
import Go from '../../ui/interior/Go.astro';
import Picture from '../../ui/Picture.astro';
import { loadServices } from '../../lib/content';
import { externalLinks } from '../../lib/site';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
const services = await loadServices();
const youtube = externalLinks.find(({ label }) => label === 'YouTube-Kanal');
---
<Interior title="Gottesdienste" description="Feiere Gottesdienst mit der Apostel-Kirchengemeinde Kiel. Hier findest du Termine und den Weg zu Gottesdiensten auf YouTube.">
  <header class="wrap in-head">
    <h1>Gottesdienste</h1>
    <p class="in-lead">Wir kommen zusammen, um zu beten, zu singen und auf Gottes Wort zu hören. Du bist eingeladen, auch wenn dir Gottesdienst noch nicht vertraut ist.</p>
  </header>
  <div class="wrap in-columns">
    <section class="in-prose" aria-labelledby="termine">
      <h2 id="termine">Nächste Termine</h2>
      <ContentState result={services} subject="Gottesdiensttermine">
        <CurrentSiteLink to="worship">Gottesdienstinfos</CurrentSiteLink>
      </ContentState>
      {services.items.length > 0 && <><p class="in-meta">Ortszeit Kiel (Europe/Berlin)</p><ServiceDates items={services.items} /></>}
      <Go href="/besuch">Tipps für deinen ersten Besuch</Go>
    </section>
    <aside class="in-side-feature">
      <Picture view="service" priority />
      <h2>Zu Hause mitfeiern</h2>
      <p>Gottesdienste und Predigten kannst du auf unserem YouTube-Kanal ansehen.</p>
      {youtube && <Go href={youtube.href} external>Zum YouTube-Kanal</Go>}
    </aside>
  </div>
</Interior>
