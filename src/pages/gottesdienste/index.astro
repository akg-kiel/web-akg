---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Photo from '../../components/Photo.astro';
import SourceState from '../../components/SourceState.astro';
import ServiceList from '../../components/ServiceList.astro';
import { loadServices } from '../../lib/content';
import { externalLinks } from '../../lib/site';

export const prerender = false;
const services = await loadServices();
Astro.response.headers.set('Cache-Control', 'no-store');
const youtube = externalLinks.find((link) => link.label === 'YouTube-Kanal');
---
<Layout title="Gottesdienste" description="Gottesdienste der Apostel-Kirchengemeinde Kiel: eine Einladung und die Übersicht der nächsten Termine.">
  <PageIntro title="Gottesdienste" description="Ob dir der Gottesdienst vertraut ist oder du zum ersten Mal kommst: Du bist willkommen, auch mit deinen Fragen." />
  <div class="container section-end journal-spread">
    <section aria-labelledby="termine-titel">
      <h2 class="journal-heading" id="termine-titel">Die nächsten Gottesdienste</h2>
      <SourceState status={services.status} kind="services" updatedAt={services.updatedAt} />
      {services.items.length > 0 && <>
        <p class="small-note journal-caption">Die Uhrzeiten gelten für Kiel. Ort und Ablauf sind noch nicht bestätigt.</p>
        <ServiceList items={services.items} headingLevel="h3" />
      </>}
      {services.items.length === 0 && <p class="journal-caption"><a class="text-link" href="/gemeinde">Unsere Gemeinde kennenlernen <span aria-hidden="true">→</span></a></p>}
    </section>
    <aside class="journal-margin" aria-label="Einblick in den Gottesdienst">
      <Photo view="service" />
      {youtube && <p class="journal-caption"><a class="text-link" href={youtube.href}>Zum YouTube-Kanal der Gemeinde <span aria-hidden="true">↗</span></a></p>}
    </aside>
  </div>
</Layout>
