---
import Interior from '../../ui/interior/Interior.astro';
import EntryMissing from '../../ui/interior/EntryMissing.astro';
import ContentState from '../../ui/interior/ContentState.astro';
import Go from '../../ui/interior/Go.astro';
import { resolveEntry } from '../../ui/interior/resolve-entry';
import { loadServices } from '../../lib/content';
import { detailPath, formatServiceTime } from '../../lib/site';

export const prerender = false;
const services = await loadServices();
const { item, unavailable } = resolveEntry(services, Astro.url.pathname, Astro.response);
const title = item?.title ?? (unavailable ? 'Gottesdienst gerade nicht abrufbar' : 'Gottesdienst nicht gefunden');
const description = item ? formatServiceTime(item) : 'Dieser Gottesdienst ist derzeit nicht verfügbar. Hier geht es zur Übersicht.';
---
<Interior title={title} description={description} canonicalPath={item && detailPath('gottesdienste', item.id)} parent={{ href: '/gottesdienste', label: 'Gottesdienste' }}>
  <article class="wrap in-detail">
    <h1>{title}</h1>
    <div class="in-prose">
      {item ? <>
        <ContentState result={services} subject="Gottesdiensttermine" />
        <div class="in-panel in-copy">
          <h2>Wann wir feiern</h2>
          <p class="in-lead"><time datetime={item.start}>{formatServiceTime(item)}</time></p>
          <p class="in-meta">Ortszeit Kiel (Europe/Berlin)</p>
        </div>
        <p>Für diesen Termin ist hier kein Ort angegeben. Wenn du Fragen zu Anfahrt oder Ablauf hast, wende dich bitte ans Gemeindebüro.</p>
        <div class="in-actions"><Go href="/kontakt">Zum Gemeindebüro</Go><Go href="/gottesdienste">Alle Gottesdienste</Go></div>
      </> : <EntryMissing unavailable={unavailable} href="/gottesdienste" label="Zur Gottesdienstübersicht" />}
    </div>
  </article>
</Interior>
