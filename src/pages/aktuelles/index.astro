---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import SourceState from '../../components/SourceState.astro';
import NewsList from '../../components/NewsList.astro';
import { loadNews } from '../../lib/content';

export const prerender = false;
const news = await loadNews();
Astro.response.headers.set('Cache-Control', 'no-store');
---
<Layout title="Aktuelles" description="Neuigkeiten und Hinweise aus der Apostel-Kirchengemeinde Kiel.">
  <PageIntro title="Aktuelles aus der Gemeinde" description="Was gibt es Neues? Hier ist Platz für Nachrichten und Hinweise aus dem Gemeindeleben." />
  <section class="container content-split section-end" aria-label="Aktuelle Meldungen">
    <div>
      <SourceState status={news.status} kind="news" updatedAt={news.updatedAt} />
      {news.items.length > 0 && <NewsList items={news.items} />}
    </div>
    <aside class="editorial-note">
      <h2>Du suchst einen Gottesdienst?</h2>
      <p>Die Gottesdiensttermine haben ihren eigenen Platz. Dort findest du auch eine kurze Einladung für deinen ersten Besuch.</p>
      <a class="text-link" href="/gottesdienste">Zu den Gottesdiensten <span aria-hidden="true">→</span></a>
      <a class="text-link" href="/gemeinde">Die Gemeinde kennenlernen <span aria-hidden="true">→</span></a>
      <p class="small-note">Ein Kalender für weitere Veranstaltungen ist in dieser Vorschau noch nicht verfügbar.</p>
    </aside>
  </section>
</Layout>
