---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import SourceState from '../../components/SourceState.astro';
import NewsList from '../../components/NewsList.astro';
import { loadNews } from '../../lib/content';

export const prerender = false;
const news = await loadNews();
Astro.response.headers.set('Cache-Control', 'no-store');
---
<Layout title="Aktuelles" description="Nachrichten und Hinweise aus der Apostel-Kirchengemeinde Kiel.">
  <PageIntro title="Aktuelles" description="Nachrichten und Hinweise aus dem Leben der Apostel-Kirchengemeinde." />
  <div class="container section-end journal-spread">
    <section aria-label="Meldungen">
      <SourceState status={news.status} kind="news" updatedAt={news.updatedAt} />
      {news.items.length > 0 && <NewsList items={news.items} />}
    </section>
    <aside class="journal-margin journal-margin-copy">
      <h2>Gottesdiensttermine</h2>
      <a class="text-link" href="/gottesdienste">Zur Gottesdienstübersicht <span aria-hidden="true">→</span></a>
    </aside>
  </div>
</Layout>
