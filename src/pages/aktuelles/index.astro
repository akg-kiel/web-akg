---
import Interior from '../../ui/interior/Interior.astro';
import ContentState from '../../ui/interior/ContentState.astro';
import CurrentSiteLink from '../../ui/interior/CurrentSiteLink.astro';
import NewsRows from '../../ui/interior/NewsRows.astro';
import Go from '../../ui/interior/Go.astro';
import { loadNews } from '../../lib/content';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
const news = await loadNews();
---
<Interior title="Aktuelles" description="Meldungen und Hinweise aus dem Leben der Apostel-Kirchengemeinde Kiel.">
  <header class="in-band"><div class="wrap in-head">
    <h1>Aktuelles</h1>
    <p class="in-lead">Was ist los in der Gemeinde? Hier findest du unsere Nachrichten und Hinweise.</p>
  </div></header>
  <div class="wrap in-section in-columns">
    <section class="in-prose" aria-labelledby="meldungen">
      <h2 id="meldungen">Meldungen</h2>
      <ContentState result={news} subject="Meldungen">
        <CurrentSiteLink to="news">Aktuelles lesen</CurrentSiteLink>
      </ContentState>
      {news.items.length > 0 && <NewsRows items={news.items} />}
    </section>
    <aside class="in-side-nav">
      <h2>Du suchst Termine?</h2>
      <Go href="/gottesdienste">Zu den Gottesdiensten</Go>
      <Go href="/angebote">Zu den Angeboten und Gruppen</Go>
    </aside>
  </div>
</Interior>
