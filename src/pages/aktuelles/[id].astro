---
import Interior from '../../ui/interior/Interior.astro';
import ContentState from '../../ui/interior/ContentState.astro';
import EntryMissing from '../../ui/interior/EntryMissing.astro';
import Go from '../../ui/interior/Go.astro';
import { resolveEntry } from '../../ui/interior/resolve-entry';
import { loadNews } from '../../lib/content';
import { detailPath, formatDate, formatNewsExcerpt } from '../../lib/site';

export const prerender = false;
const news = await loadNews();
const { item, unavailable } = resolveEntry(news, Astro.url.pathname, Astro.response);
const title = item?.title ?? (unavailable ? 'Meldung gerade nicht abrufbar' : 'Meldung nicht gefunden');
const description = item?.body ? formatNewsExcerpt(item.body) : 'Nachricht aus der Apostel-Kirchengemeinde Kiel.';
---
<Interior title={title} description={description} parent={{ href: '/aktuelles', label: 'Aktuelles' }} canonicalPath={item && detailPath('aktuelles', item.id)}>
  <article class="wrap in-detail">
    <h1>{title}</h1>
    <div class="in-prose">
      {item ? <>
        <p class="in-meta">Veröffentlicht am <time datetime={item.publishedAt}>{formatDate(item.publishedAt)}</time>
          {item.updatedAt && item.updatedAt !== item.publishedAt && <> · Bearbeitet am <time datetime={item.updatedAt}>{formatDate(item.updatedAt)}</time></>}
        </p>
        <ContentState result={news} subject="Meldungen" />
        <p class="in-article-body">{item.body || 'Zu dieser Meldung ist kein weiterer Text veröffentlicht.'}</p>
        <Go href="/aktuelles">Alle Meldungen</Go>
      </> : <EntryMissing unavailable={unavailable} href="/aktuelles" label="Zu allen Meldungen" />}
    </div>
  </article>
</Interior>
