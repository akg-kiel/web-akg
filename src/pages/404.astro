---
import Interior from '../ui/interior/Interior.astro';
import Go from '../ui/interior/Go.astro';
export const prerender = true;
---
<Interior title="Seite nicht gefunden" description="Unter dieser Adresse gibt es keine Seite. Über die Startseite oder den Besuchswegweiser findest du weiter." canonicalPath="/404">
  <div class="wrap in-detail">
    <h1>Seite nicht gefunden</h1>
    <div class="in-prose">
      <p class="in-lead">Unter dieser Adresse gibt es keine Seite. Vielleicht hat sich der Link geändert.</p>
      <div class="in-actions"><Go href="/" primary>Zur Startseite</Go><Go href="/besuch">Deinen Besuch planen</Go></div>
    </div>
  </div>
</Interior>
