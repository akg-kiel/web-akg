---
import Interior from '../ui/interior/Interior.astro';
import OfferDetails from '../ui/interior/OfferDetails.astro';
import ContentState from '../ui/interior/ContentState.astro';
import CurrentSiteLink from '../ui/interior/CurrentSiteLink.astro';
import Picture from '../ui/Picture.astro';
import Go from '../ui/interior/Go.astro';
import { loadGroups } from '../lib/content';
import { cafeSite } from '../lib/site';
import type { GroupOffer } from '../lib/server/churchtools';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
const groups = await loadGroups();
const query = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 100);
// HTML collapses whitespace in feed titles and descriptions; search them as displayed.
const searchable = (text: string) => text.replace(/\s+/gu, ' ').trim().toLocaleLowerCase('de');
const term = searchable(query);
const selected = Astro.url.searchParams.get('angebot');
const matches = groups.items.filter(offer =>
  [offer.name, offer.description, offer.type].some(field => field && searchable(field).includes(term))
);
const byType = new Map<string, GroupOffer[]>();
for (const offer of matches) {
  const category = byType.get(offer.type);
  if (category) category.push(offer);
  else byType.set(offer.type, [offer]);
}
const categories = Array.from(byType).sort(([a], [b]) => a.localeCompare(b, 'de'));
---
<Interior title="Angebote & Gruppen" description="Suche nach Angeboten und Gruppen der Apostel-Kirchengemeinde Kiel und finde heraus, wie du mitmachen kannst.">
  <header class="in-tint"><div class="wrap in-head">
    <h1>Angebote &amp; Gruppen</h1>
    <p class="in-lead">Gemeinsam etwas unternehmen, beten oder über den Glauben sprechen: Was interessiert dich?</p>
  </div></header>
  <div class="wrap in-section in-columns">
    <section aria-label="Gruppen finden" class="in-prose">
      <ContentState result={groups} subject="Gruppenangebote">
        <CurrentSiteLink to="groups">Angebote und Gruppen</CurrentSiteLink>
      </ContentState>
      {groups.items.length > 0 && <>
        <form role="search" action="/angebote" method="get" class="in-search">
          <label for="gruppensuche">Gruppe oder Thema suchen</label>
          <div><input type="search" name="q" id="gruppensuche" maxlength="100" value={query} /><button type="submit" class="action">Suchen</button></div>
        </form>
        <p class="in-meta">{matches.length} {matches.length === 1 ? 'Angebot' : 'Angebote'}{query && <> für „{query}“ · <a href="/angebote">Alle anzeigen</a></>}</p>
        {categories.length === 0 && <p>Kein passendes Angebot gefunden. Versuche es mit einem anderen Suchbegriff.</p>}
        {categories.map(([type, offers]) => <section class="in-offer-set">
          <h2>{type}</h2>
          {offers.map(offer => <OfferDetails offer={offer} selected={selected === offer.id} />)}
        </section>)}
      </>}
    </section>
    <aside class="in-side-feature">
      <Picture view="cafe" />
      <h2>{cafeSite.label}</h2>
      <p>Lieber bei einer Tasse Kaffee ins Gespräch kommen? Plane deinen Besuch auf der eigenen Website des Cafés.</p>
      <Go href={cafeSite.href} external>Zum Café Dreimaster</Go>
    </aside>
  </div>
</Interior>
