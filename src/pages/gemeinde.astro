---
import Interior from '../ui/interior/Interior.astro';
import Go from '../ui/interior/Go.astro';
import Picture from '../ui/Picture.astro';
import { places } from '../lib/site';

export const prerender = true;
---
<Interior title="Unsere Gemeinde" description="Lerne die Apostel-Kirchengemeinde Kiel kennen: die Menschen, unseren Glauben an Jesus Christus und die Geschichte unserer Orte.">
  <header class="in-band"><div class="wrap in-head in-split">
    <div class="in-copy">
      <h1>Unsere Gemeinde</h1>
      <p class="in-lead">Wir sind Menschen aus Kiel, die der Glaube an Jesus Christus verbindet. Wenn du deinen Glauben teilst oder Fragen mitbringst: Du bist bei uns willkommen.</p>
      <Go href="/besuch">Zum ersten Mal hier?</Go>
    </div>
    <Picture view="gathering" priority />
  </div></header>
  <div class="wrap in-section in-columns">
    <div class="in-chapters">
      <section id="leitbild" class="in-prose">
        <h2>Woran wir glauben</h2>
        <p>Wir möchten Jesus nachfolgen. Für uns heißt das: nicht nur von seiner Liebe erzählen, sondern sie auch im Alltag zeigen. Wir beten miteinander, achten einander und wollen barmherzig mit Fehlern umgehen.</p>
      </section>
      <section class="in-prose">
        <h2>Wer hier mitmacht</h2>
        <p>Jung und Alt bringen unterschiedliche Fragen und Begabungen mit. Beim Gottesdienst und in kleineren Gruppen wird daraus Gemeinschaft. Wenn du magst, komm dazu.</p>
        <Go href="/angebote">Angebote und Gruppen entdecken</Go>
      </section>
      <section id="geschichte" class="in-prose">
        <h2>Wie Apostel entstand</h2>
        <dl class="in-history">
          <div><dt>2008</dt><dd>Die Gemeinden Petrus-Süd und Jakobi-West schließen sich zur Apostel-Kirchengemeinde Kiel zusammen.</dd></div>
          <div><dt>2016</dt><dd>Im März zieht die Gemeinde in die Petruskirche in der Wik ein.</dd></div>
        </dl>
      </section>
    </div>
    <section id="orte" class="in-side-nav">
      <h2>Unsere Orte</h2>
      <ul role="list">{places.map(place => <li><Go href={place.href}>{place.label}</Go></li>)}</ul>
    </section>
  </div>
</Interior>
