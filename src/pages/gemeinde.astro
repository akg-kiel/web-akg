---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Photo from '../components/Photo.astro';
import { places } from '../lib/site';
export const prerender = true;
---
<Layout title="Gemeinde & Orte" description="Was die Apostel-Kirchengemeinde Kiel verbindet: Glaube, Geschichte und die Orte unserer Gemeinde.">
  <PageIntro title="Unsere Gemeinde" description="Wir sind die Apostel-Kirchengemeinde in Kiel. Was uns verbindet, ist der Wunsch, Glauben und Alltag miteinander zu teilen.">
    <Photo slot="photo" view="gathering" hero />
  </PageIntro>

  <div class="container section-end">
    <div class="journal-spread">
      <section id="leitbild" class="journal-reading" aria-labelledby="leitbild-titel">
        <h2 id="leitbild-titel">Was uns verbindet</h2>
        <p>Jesus Christus steht im Mittelpunkt unseres Glaubens. Wir möchten ihm folgen und seine Liebe weitergeben – durch das, was wir sagen, und durch das, was wir tun.</p>
        <p>In unserem Leitbild heißt das: Menschen mit unterschiedlichen Erfahrungen und Begabungen haben Platz. Wir wollen miteinander beten, einander achten und barmherzig mit Fehlern umgehen.</p>
        <p class="small-note">Text zum Leitbild · redaktionelle Abnahme steht noch aus.</p>
      </section>
      <section id="orte" class="journal-margin" aria-labelledby="orte-titel">
        <h2 class="journal-heading" id="orte-titel">Unsere Orte</h2>
        <ul class="place-links" role="list">
          {places.map(({ href, label }) => (
            <li><a href={href}>{label}<span aria-hidden="true">→</span></a></li>
          ))}
        </ul>
        <p class="small-note journal-caption">Adressen, Anfahrt und Zugänglichkeit sind noch nicht bestätigt.</p>
      </section>
    </div>

    <section class="journal-history" aria-labelledby="geschichte-titel">
      <h2 id="geschichte-titel">Wie alles anfing</h2>
      <dl class="history-dates">
        <div><dt>2008</dt><dd>Aus Petrus-Süd und Jakobi-West wird die Apostel-Kirchengemeinde.</dd></div>
        <div><dt>2016</dt><dd>Im März zieht die Gemeinde in die Petruskirche ein.</dd></div>
      </dl>
      <p class="small-note">Angaben zur Gemeindegeschichte · redaktionelle Abnahme steht noch aus.</p>
    </section>
  </div>
</Layout>
