---
interface Props { view?: 'outside' | 'ceiling' | 'portal' | 'side'; hero?: boolean; enlarge?: boolean }
const { view = 'outside', hero = false, enlarge = false } = Astro.props;
const photos = {
  outside: {
    name: 'petruskirche', height: 768,
    alt: 'Die Petruskirche in Kiel-Wik: Backsteinturm und Vorplatz unter blauem Himmel.',
    source: 'Petruskirche-Wik-2024-msu-2530.jpg', author: 'Matthias Süßen', license: '4.0'
  },
  ceiling: {
    name: 'petruskirche-dach', height: 640,
    alt: 'Blick hinauf in den offenen hölzernen Dachstuhl der Petruskirche.',
    source: 'Petruskirche-Kiel-2026-09-msu--3400.jpg', author: 'Matthias Süßen', license: '4.0'
  },
  portal: {
    name: 'petruskirche-portal', height: 1440,
    alt: 'Ein Backsteinportal der Petruskirche mit Holztür, Metallbeschlägen und Laterne.',
    source: 'Petruskirche_(Kiel-Wik)-msu-2532-2532.jpg', author: 'Matthias Süßen', license: '4.0'
  },
  side: {
    name: 'petruskirche-seite', height: 640,
    alt: 'Die Petruskirche von der Seite mit Kirchenschiff, Turm und kahlen Bäumen, aufgenommen 2015.',
    source: 'Petruskirche_Kiel_15_(16739510725).jpg', author: 'Rüdiger Stehn', license: '2.0'
  }
};
const photo = photos[view];
const Frame = enlarge ? 'a' : 'div';
---
<figure class:list={[hero ? 'welcome-photo' : 'feature-picture', `photo-${view}`]}>
  <Frame class="photo-frame" href={enlarge ? `/images/${photo.name}-1440.webp` : undefined} data-enlarge={enlarge || undefined} aria-label={enlarge ? `Foto ansehen: ${photo.alt}` : undefined}>
    <img
      src={`/images/${photo.name}-960.webp`}
      srcset={[640, 960, 1440].map((width) => `/images/${photo.name}-${width}.webp ${width}w`).join(', ')}
      sizes={hero ? '100vw' : view === 'portal' ? '(min-width: 768px) 35vw, 100vw' : '(min-width: 768px) 60vw, 100vw'}
      width="960" height={photo.height} alt={photo.alt}
      style={enlarge ? { aspectRatio: `960 / ${photo.height}` } : undefined}
      loading={hero ? 'eager' : 'lazy'} fetchpriority={hero ? 'high' : 'auto'} decoding="async"
    />
    {enlarge && <span class="photo-action" aria-hidden="true">Foto ansehen <span>+</span></span>}
  </Frame>
  <figcaption class="photo-credit">
    Foto: <a href={`https://commons.wikimedia.org/wiki/File:${photo.source}`} title={photo.source}>{photo.author} ↗</a> · <a href={`https://creativecommons.org/licenses/by-sa/${photo.license}/`}>CC BY-SA {photo.license} ↗</a> · Bildausschnitt, komprimiert
  </figcaption>
</figure>
