---
interface Props {
  title: string;
  description?: string;
  parent?: { label: string; href: string };
}
const { title, description, parent } = Astro.props;
---
<header class:list={['page-intro', 'container', { 'intro-illustrated': Astro.slots.has('photo') }]}>
  {parent && <a class="intro-parent" href={parent.href}><span aria-hidden="true">←</span> {parent.label}</a>}
  <div class="intro-opening">
    <div class="intro-heading">
      <h1>{title}</h1>
      {description && <p class="intro-text">{description}</p>}
      <slot />
    </div>
    <slot name="photo" />
  </div>
</header>
