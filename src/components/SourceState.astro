---
import { formatUpdated } from '../lib/site';
interface Props {
  status: 'ready' | 'empty' | 'stale' | 'unavailable' | 'disabled';
  kind: 'services' | 'news' | 'groups';
  updatedAt?: string;
  compact?: boolean;
}
const { status, kind, updatedAt, compact = false } = Astro.props;
const subject = { services: 'Gottesdiensttermine', groups: 'Angebote', news: 'Meldungen' }[kind];
const messages = {
  disabled: {
    title: `${subject} sind in dieser Vorschau noch nicht freigeschaltet.`
  },
  empty: {
    title: kind === 'services' ? 'Für die nächste Zeit sind keine Gottesdiensttermine veröffentlicht.' : `Zurzeit sind keine ${subject} veröffentlicht.`
  },
  unavailable: {
    title: `${subject} lassen sich gerade nicht laden.`,
    body: 'Bitte versuche es später noch einmal.'
  },
  stale: {
    title: 'Zuletzt bestätigter Stand',
    body: 'Die aktuellen Angaben lassen sich gerade nicht abrufen. Seit diesem Stand kann sich etwas geändert haben.'
  }
};
const message = status === 'ready' ? undefined : messages[status];
---
{message && (
  <div class:list={['source-state', { 'source-state-stale': status === 'stale', 'source-state-compact': compact }]} data-source-state={status}>
    <p class="state-title">{message.title}</p>
    {'body' in message && (!compact || status === 'stale') && <p>{message.body}</p>}
    {status === 'stale' && updatedAt && (
      <p class="data-stamp">Stand: <time datetime={updatedAt}>{formatUpdated(updatedAt)}</time> (Europe/Berlin)</p>
    )}
  </div>
)}
