---
interface Props {
  unavailable: boolean;
  section: 'gottesdienste' | 'aktuelles';
}
const { unavailable, section } = Astro.props;
---
<div class="container section-end">
  <div class="journal-reading">
    <p>{unavailable
      ? 'Ob dieser Eintrag veröffentlicht ist, lässt sich zurzeit nicht prüfen. Bitte versuche es später noch einmal.'
      : 'Unter dieser Adresse gibt es keinen veröffentlichten Eintrag. In der Übersicht findest du die verfügbaren Einträge.'}</p>
    <a class="text-link" href={`/${section}`}>{section === 'gottesdienste' ? 'Zur Gottesdienstübersicht' : 'Zu allen Meldungen'} <span aria-hidden="true">→</span></a>
  </div>
</div>
